{{ _foomuuri_marker_line }}
# foomuuri-role-sections: {{ _foomuuri_sections | join(' ') }}
# foomuuri-role-closed: {{ _foomuuri_closed_sections | join(' ') }}
# foomuuri-role-ssh: {{ 'yes' if _foomuuri_has_ssh | bool else 'no' }}
{% if _foomuuri_is_base | bool %}
{% if foomuuri_config | length > 0 %}

foomuuri {
{% for option, value in foomuuri_config.items() %}
  {{ option }} {{ value }}
{% endfor %}
}
{% endif %}

zone {
{% for zone, interfaces in foomuuri_zones.items() %}
  {{ (zone ~ ' ' ~ (interfaces | join(' '))) | trim }}
{% endfor %}
}
{% endif %}
{% if foomuuri_macros | length > 0 %}

macro {
{% for name, value in foomuuri_macros.items() %}
  {{ name }} {{ value }}
{% endfor %}
}
{% endif %}
{% if foomuuri_iplists | length > 0 %}

iplist {
{% for name, value in foomuuri_iplists.items() %}
  {{ name }} {{ value }}
{% endfor %}
}
{% endif %}
{% for name, rules in foomuuri_templates.items() %}

template {{ name }} {
{% for rule in rules %}
  {{ rule }}
{% endfor %}
}
{% endfor %}
{% for section, rules in _foomuuri_rules_merged.items() %}

{{ section }} {
{% for rule in rules %}
  {{ rule }}
{% endfor %}
}
{% endfor %}
